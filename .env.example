# Copy to .env and change for your machine. Do not commit .env.

# Port of the dashboard and API when running with docker compose
TOKENFEST_PORT=8080

POSTGRES_DB=tokenfest
POSTGRES_USER=tokenfest
POSTGRES_PASSWORD=tokenfest
POSTGRES_PORT=5432

# Encrypts provider API keys in the database. Generate once and keep it:
#   openssl rand -base64 32
# If you lose or change it, provider API keys must be entered again.
TOKENFEST_ENCRYPTION_KEY=

# Password of the first admin account ("admin"). If empty, a random one is printed in the backend log.
TOKENFEST_ADMIN_PASSWORD=

# Optional: SMTP server for email alerts (see README)
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# TOKENFEST_ALERT_FROM=

# Optional: zone for budget months and daily charts (default UTC)
# TOKENFEST_TIME_ZONE=America/New_York
# Optional: days to keep request logs (default 90, 0 = forever)
# TOKENFEST_LOG_RETENTION_DAYS=90
